#!/bin/bash
CURRENT_DIR=$(pwd)

# do not hard code /usr/bin/node, a node upgrade (nvm, a tarball, a distro change)
# moves the binary and the service then dies with status=203/EXEC on every restart
NODE_BIN=$(command -v node)

if [ -z "$NODE_BIN" ]; then
    echo "node was not found in PATH, install it first"
    exit 1
fi

echo "Using node at $NODE_BIN ($($NODE_BIN --version))"

make_service()
{
cat <<EOF
[Unit]
\rDescription="S1 Panel"
\r
\r[Service]
\rExecStart=$NODE_BIN main.js
\rWorkingDirectory=$CURRENT_DIR
\rRestart=always
\rRestartSec=10
\rSyslogIdentifier=s1panel
\rEnvironment=SERVICE=true
\r
\r[Install]
\rWantedBy=multi-user.target
\r
EOF
}

echo "Home Directory is $CURRENT_DIR"
npm i

# canvas, node-hid and serialport ship prebuilt binaries fetched by their install
# scripts (prebuild-install / pkg-prebuilds-verify, falling back to node-gyp).
# newer npm can hold those scripts back, and the panel would then fail at require
# time with a service that restarts forever. fail here instead, while someone is
# still looking at the screen
echo "Verifying native modules..."
if ! "$NODE_BIN" -e "require('canvas'); require('node-hid'); require('serialport');" 2>/dev/null; then
    echo ""
    echo "ERROR: a native module did not load."
    echo "npm may be holding back the install scripts that fetch the prebuilt binaries."
    echo "  review : npm install-scripts ls"
    echo "  allow  : npm install-scripts approve canvas node-hid @serialport/bindings-cpp"
    echo "then run ./install again"
    exit 1
fi
echo "Native modules OK"

(cd gui; npm i)
echo "Building GUI"
(cd gui; npm run build)
echo "Install Service..."
echo -e "$(make_service)" > /etc/systemd/system/s1panel.service
echo "Reload Service Daemon..."
systemctl daemon-reload
echo "Enable s1panel..."
systemctl enable s1panel.service
echo "Start s1panel..."
systemctl start s1panel.service
echo "Done!"
systemctl status s1panel.service
